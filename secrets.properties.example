# Copy to secrets.properties (not committed). Values can also come from environment variables of the same name.

# The staging gate's password, sent as X-Mildcrowd-Gate to staging.mildcrowd.com (staging build type only).
MILDCROWD_GATE_KEY=

# Debug builds on a real phone: the Mac's LAN address instead of the emulator's 10.0.2.2.
# MILDCROWD_DEBUG_BASE_URL=http://192.168.1.20
# MILDCROWD_DEBUG_REVERB_HOST=192.168.1.20
